{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "PhichatIssuer",
    "Audience": "PhichatAudience",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "RegistrationTokenMinutes": 15
  },
  "Auth": {
    "RefreshCookie": {
      "Name": "phichat_rt",
      "Path": "/api/auth",
      "SameSite": "Strict"
    }
  },
  "SmsCode": {
    "CodeLifetimeMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxCodesPerHour": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "AllowedHosts": "*"
}
